{
  "name": "@erp/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "prisma generate && tsc -p tsconfig.build.json && concurrently -k -n tsc,api \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --env-file-if-exists=.env dist/main.js\"",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seed": "node --env-file-if-exists=.env dist/seed.js",
    "migrate:deploy": "prisma migrate deploy",
    "test:int": "vitest run --config vitest.int.config.ts",
    "worker": "node --env-file-if-exists=.env dist/worker.js"
  },
  "dependencies": {
    "@erp/contracts": "workspace:*",
    "@erp/scoring": "workspace:*",
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cookie-parser": "^1.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-dist": "5.35.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/swagger-ui-dist": "^3.30.6",
    "concurrently": "^10.0.7",
    "prisma": "7.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
