# Copy to apps/api/.env
DATABASE_URL=postgresql://erp:erp@localhost:5432/erp
REDIS_URL=redis://localhost:6379
API_PORT=4000
SESSION_COOKIE_NAME=erp_session
SESSION_TTL_HOURS=168
# API reference at /docs/ and /openapi.json: on by default except in production. Set on or off to override.
# API_DOCS=on
# Seed-only: password given to every seeded account. Local development only.
SEED_PASSWORD=change-me-locally
# Optional: separate shadow database for `prisma migrate dev` (needed with `prisma dev`).
# SHADOW_DATABASE_URL=
# Integration tests use apps/api/.env.test with TEST_DATABASE_URL pointing at a throwaway database.
